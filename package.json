{
  "name": "posprint-emu",
  "version": "0.1.0",
  "description": "ESC/POS receipt printer emulator with a live WYSIWYG web viewer",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:send": "tsx scripts/send-test-job.ts",
    "lint": "eslint src test scripts"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
